#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
source "$SCRIPT_DIR/omarchy-shorten-url-lib"

CONFIG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-shorten-url"
if [[ -n "${OMARCHY_SHORTEN_URL_CONFIG:-}" ]]; then
  CONFIG_FILE="$OMARCHY_SHORTEN_URL_CONFIG"
else
  CONFIG_FILE="$CONFIG_DIR/config.json"
fi
HISTORY_FILE="${OMARCHY_SHORTEN_URL_HISTORY:-$CONFIG_DIR/history.json}"
HISTORY_LIMIT=5

usage() {
  cat <<'EOF'
Usage: omarchy-shorten-url [URL] [--profile NAME] [--config PATH]
       omarchy-shorten-url --history [N]
       omarchy-shorten-url --copy TEXT

If URL is omitted, it is read from the Wayland clipboard (wl-paste).
The URL is shortened using the configured provider and the result is
written back to the clipboard (wl-copy) and printed to stdout. The
5 most recent shortened URLs are recorded and can be listed with
--history (as a JSON array, most recent first).
EOF
}

profile_override=""
url=""
show_history=false
copy_mode=false
copy_value=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) profile_override="$2"; shift 2 ;;
    --config) CONFIG_FILE="$2"; shift 2 ;;
    --history)
      show_history=true
      shift
      if [[ $# -gt 0 && "$1" =~ ^[0-9]+$ ]]; then
        HISTORY_LIMIT="$1"
        shift
      fi
      ;;
    --copy) copy_mode=true; copy_value="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) url="$1"; shift ;;
  esac
done

die() {
  echo "omarchy-shorten-url: $*" >&2
  command -v notify-send >/dev/null 2>&1 && notify-send -u critical "Shorten URL" "$*"
  exit 1
}

command -v jq >/dev/null 2>&1 || die "jq is required"
command -v curl >/dev/null 2>&1 || die "curl is required"

history_is_valid() {
  printf '%s' "$1" | assert_json_limits && printf '%s' "$1" | assert_json_shape array
}

if $show_history; then
  history_json="$(read_bounded_file "$HISTORY_FILE" 2>/dev/null || true)"
  if [[ -n "$history_json" ]] && history_is_valid "$history_json"; then
    printf '%s' "$history_json" | jq -c ".[0:${HISTORY_LIMIT}]" 2>/dev/null || echo "[]"
  else
    echo "[]"
  fi
  exit 0
fi

if $copy_mode; then
  [[ -n "$copy_value" ]] || die "no text provided to --copy"
  command -v wl-copy >/dev/null 2>&1 || die "wl-copy is required"
  printf '%s' "$copy_value" | wl-copy -n
  exit 0
fi

if [[ -z "$url" ]]; then
  command -v wl-paste >/dev/null 2>&1 || die "wl-paste is required to read the clipboard"
  url="$(wl-paste -n 2>/dev/null | tr -d '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
fi

[[ -n "$url" ]] || die "no URL provided and clipboard is empty"
[[ "$url" =~ ^https?:// ]] || die "input does not look like a URL: $url"

config_json="$(read_bounded_file "$CONFIG_FILE" --credential)" || die "config file not found, not a plain regular file, or too large: $CONFIG_FILE (copy config.example.json to config.json)"
printf '%s' "$config_json" | assert_json_limits || die "config file exceeds size/shape limits: $CONFIG_FILE"
printf '%s' "$config_json" | assert_json_shape object || die "config file is not a JSON object: $CONFIG_FILE"
config_json="$(printf '%s' "$config_json" | canonicalize_config)" || die "config file must have a top-level \"profiles\" object: $CONFIG_FILE (copy config.example.json to config.json)"
printf '%s' "$config_json" | assert_config_schema || die "config file has an invalid provider profile: $CONFIG_FILE"

profile_name="$profile_override"
if [[ -z "$profile_name" ]]; then
  profile_name="$(printf '%s' "$config_json" | jq -r '.defaultProfile // empty')"
fi

if [[ -n "$profile_name" ]]; then
  provider="$(printf '%s' "$config_json" | jq -r --arg p "$profile_name" '.profiles[$p].type // empty')"
  [[ -n "$provider" ]] || die "profile not found: $profile_name"
else
  die "no default profile configured (set one in $CONFIG_FILE, or pass --profile NAME)"
fi

cfg() {
  printf '%s' "$config_json" | jq -r --arg p "$profile_name" --arg k "$1" '.profiles[$p][$k] // empty'
}

curl_config_quote() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  printf '"%s"' "$value"
}

curl_config_line() {
  local key="$1" value="$2"
  printf '%s = %s' "$key" "$(curl_config_quote "$value")"
}

curl_config_add() {
  CURL_CONFIG+="$(curl_config_line "$1" "$2")"
  CURL_CONFIG+=$'\n'
}

curl_config_add_flag() {
  CURL_CONFIG+="$1"
  CURL_CONFIG+=$'\n'
}

curl_request() {
  curl_config_add connect-timeout 5
  curl_config_add max-time 20
  curl_config_add max-filesize 65536
  curl --config /dev/fd/3 3<<<"$CURL_CONFIG"
}

cap_response() {
  local response_file response_size
  response_file="$(mktemp)"
  if ! head -c 65537 >"$response_file"; then
    rm -f -- "$response_file"
    return 1
  fi
  response_size="$(wc -c <"$response_file")"
  if (( response_size > 65536 )); then
    rm -f -- "$response_file"
    echo "provider response exceeds 65536 bytes" >&2
    return 1
  fi
  cat "$response_file"
  rm -f -- "$response_file"
}

shorten_yourls() {
  local api_url signature username password short
  api_url="$(cfg apiUrl)"
  signature="$(cfg signature)"
  username="$(cfg username)"
  password="$(cfg password)"
  [[ -n "$api_url" ]] || die "yourls.apiUrl not configured"
  [[ "$api_url" == */yourls-api.php ]] || api_url="${api_url%/}/yourls-api.php"

  CURL_CONFIG=""
  curl_config_add url "$api_url"
  curl_config_add request POST
  curl_config_add data-urlencode "action=shorturl"
  curl_config_add data-urlencode "url=$url"
  curl_config_add data-urlencode "format=json"
  if [[ -n "$signature" ]]; then
    curl_config_add data-urlencode "signature=$signature"
  elif [[ -n "$username" && -n "$password" ]]; then
    curl_config_add data-urlencode "username=$username"
    curl_config_add data-urlencode "password=$password"
  else
    die "yourls requires either signature or username+password"
  fi

  curl_config_add_flag silent
  curl_config_add_flag show-error
  curl_config_add_flag fail
  short="$(curl_request | cap_response | jq -r '.shorturl // empty')"
  [[ -n "$short" ]] || die "yourls did not return a shorturl"
  echo "$short"
}

shorten_shlink() {
  local api_url api_key short
  api_url="$(cfg apiUrl)"
  api_key="$(cfg apiKey)"
  [[ -n "$api_url" && -n "$api_key" ]] || die "shlink.apiUrl and shlink.apiKey must be configured"

  CURL_CONFIG=""
  curl_config_add url "${api_url%/}/rest/v3/short-urls"
  curl_config_add request POST
  curl_config_add header "X-Api-Key: $api_key"
  curl_config_add header 'Content-Type: application/json'
  curl_config_add data "$(jq -n --arg u "$url" '{longUrl: $u}')"
  curl_config_add_flag silent
  curl_config_add_flag show-error
  curl_config_add_flag fail
  short="$(curl_request | cap_response | jq -r '.shortUrl // empty')"
  [[ -n "$short" ]] || die "shlink did not return a shortUrl"
  echo "$short"
}

shorten_kutt() {
  local api_url api_key short
  api_url="$(cfg apiUrl)"
  api_key="$(cfg apiKey)"
  [[ -n "$api_url" && -n "$api_key" ]] || die "kutt.apiUrl and kutt.apiKey must be configured"

  CURL_CONFIG=""
  curl_config_add url "${api_url%/}/api/v2/links"
  curl_config_add request POST
  curl_config_add header "X-API-KEY: $api_key"
  curl_config_add header 'Content-Type: application/json'
  curl_config_add data "$(jq -n --arg u "$url" '{target: $u}')"
  curl_config_add_flag silent
  curl_config_add_flag show-error
  curl_config_add_flag fail
  short="$(curl_request | cap_response | jq -r '.link // empty')"
  [[ -n "$short" ]] || die "kutt did not return a link"
  echo "$short"
}

shorten_polr() {
  local api_url api_key short
  api_url="$(cfg apiUrl)"
  api_key="$(cfg apiKey)"
  [[ -n "$api_url" && -n "$api_key" ]] || die "polr.apiUrl and polr.apiKey must be configured"

  CURL_CONFIG=""
  curl_config_add url "${api_url%/}/api/v2/action/shorten"
  curl_config_add request POST
  curl_config_add data-urlencode "url=$url"
  curl_config_add data-urlencode "key=$api_key"
  curl_config_add_flag silent
  curl_config_add_flag show-error
  curl_config_add_flag fail
  short="$(curl_request | cap_response)"
  [[ -n "$short" ]] || die "polr did not return a short URL"
  echo "$short"
}

shorten_bitly() {
  local api_url access_token short
  api_url="https://api-ssl.bitly.com"
  access_token="$(cfg accessToken)"
  [[ -n "$api_url" && -n "$access_token" ]] || die "bitly.apiUrl and bitly.accessToken must be configured"

  CURL_CONFIG=""
  curl_config_add url "${api_url%/}/v4/shorten"
  curl_config_add request POST
  curl_config_add header "Authorization: Bearer $access_token"
  curl_config_add header 'Content-Type: application/json'
  curl_config_add data "$(jq -n --arg u "$url" '{long_url: $u}')"
  curl_config_add_flag silent
  curl_config_add_flag show-error
  curl_config_add_flag fail
  short="$(curl_request | cap_response | jq -r '.link // empty')"
  [[ -n "$short" ]] || die "bitly did not return a link"
  echo "$short"
}

case "$provider" in
  yourls) short_url="$(shorten_yourls)" ;;
  shlink) short_url="$(shorten_shlink)" ;;
  kutt)   short_url="$(shorten_kutt)" ;;
  polr)   short_url="$(shorten_polr)" ;;
  bitly)  short_url="$(shorten_bitly)" ;;
  *) die "unknown provider: $provider (expected yourls, shlink, kutt, polr, or bitly)" ;;
esac

record_history() {
  local entry tmp dir existing_history
  dir="$(dirname "$HISTORY_FILE")"
  mkdir -p "$dir"
  entry="$(jq -n --arg s "$short_url" --arg l "$url" --arg p "$provider" \
    --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{shortUrl: $s, longUrl: $l, provider: $p, timestamp: $t}')"
  tmp="$(mktemp "$dir/.history.XXXXXX")"
  existing_history="$(read_bounded_file "$HISTORY_FILE" 2>/dev/null || true)"
  if [[ -n "$existing_history" ]] && history_is_valid "$existing_history"; then
    printf '%s' "$existing_history" | jq --argjson e "$entry" '([$e] + .) | .[0:5]' > "$tmp" 2>/dev/null || echo "[$entry]" > "$tmp"
  else
    echo "[$entry]" > "$tmp"
  fi
  mv "$tmp" "$HISTORY_FILE"
}

record_history || echo "omarchy-shorten-url: warning: failed to record history" >&2

if command -v wl-copy >/dev/null 2>&1; then
  printf '%s' "$short_url" | wl-copy -n
else
  echo "omarchy-shorten-url: warning: wl-copy not found, clipboard not updated" >&2
fi

command -v notify-send >/dev/null 2>&1 && notify-send "Shorten URL" "$short_url"

echo "$short_url"
